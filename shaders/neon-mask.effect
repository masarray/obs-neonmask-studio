// SPDX-License-Identifier: GPL-2.0-or-later
// One source-space signed-distance field drives mask, stroke and analytic halo.
// No duplicate geometry or full-frame blur texture is required for this MVP.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_size;
uniform float2 half_size;
uniform float2 mask_offset;
uniform float2 subject_pan;
uniform float subject_zoom;
uniform int polygon_sides;
uniform float polygon_rotation;
uniform float corner_radius;
uniform int shape_id;
uniform float border_width;
uniform int style_id;
uniform float feather;
uniform float glow_radius;
uniform float glow_strength;
uniform float4 color_a;
uniform float4 color_b;
uniform float color_phase;
uniform float pulse_phase;
uniform float flow_phase;
uniform int animation_id;
uniform int segment_count;
uniform int border_enabled;
uniform int glow_enabled;

sampler_state image_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData mainTransform(VertData v_in)
{
    v_in.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    return v_in;
}

float roundedBoxDistance(float2 p, float2 bounds, float radius)
{
    float2 q = abs(p) - (bounds - radius);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
}

float ellipseDistance(float2 p, float2 r)
{
    // A close Euclidean-distance approximation; unlike UV scaling, this keeps
    // an ellipse's neon width visually consistent near the silhouette.
    float k0 = length(p / r);
    if (k0 < 0.0001) return -min(r.x, r.y);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 0.00001);
}


/* Pixel-space distance to actual polygon edges, preserving stroke width on
 * non-square source sizes. +Y down; vertices proceed clockwise. */
float polygonDistance(float2 p, int sides, float rotation_deg)
{
    const float PI = 3.14159265359;
    float phase = -0.5 * PI + ((sides % 2) == 0 ? PI / sides : 0.0)
                  + rotation_deg * PI / 180.0;
    float stepAngle = 2.0 * PI / sides;
    float bestSq = 1.0e20;
    bool inside = true;
    for (int i = 0; i < 12; ++i) {
        if (i >= sides) break;
        float a = phase + i * stepAngle;
        float b = a + stepAngle;
        float2 v0 = half_size * float2(cos(a), sin(a));
        float2 v1 = half_size * float2(cos(b), sin(b));
        float2 edge = v1 - v0;
        float2 rel = p - v0;
        float t = saturate(dot(rel, edge) / max(dot(edge, edge), 0.0001));
        float2 nearest = rel - t * edge;
        bestSq = min(bestSq, dot(nearest, nearest));
        if (edge.x * rel.y - edge.y * rel.x < -0.00001)
            inside = false;
    }
    return (inside ? -1.0 : 1.0) * sqrt(bestSq);
}

float shapeDistance(float2 p)
{
    if (shape_id == 1) return length(p) - min(half_size.x, half_size.y);
    if (shape_id == 2) return ellipseDistance(p, half_size);
    if (shape_id == 3) return polygonDistance(p, 6, polygon_rotation);
    if (shape_id == 5) return roundedBoxDistance(p, half_size, 0.0);
    if (shape_id == 6) return polygonDistance(p, 3, polygon_rotation);
    if (shape_id == 7) return polygonDistance(p, polygon_sides, polygon_rotation);
    if (shape_id == 4) {
        float2 q = abs(p);
        return (q.x * half_size.y + q.y * half_size.x -
                half_size.x * half_size.y) / length(half_size);
    }
    return roundedBoxDistance(p, half_size,
                              min(corner_radius, min(half_size.x, half_size.y)));
}

float4 drawNeonMask(VertData v_in) : TARGET
{
    const float TAU = 6.28318530718;
    float2 p = v_in.uv * uv_size - uv_size * 0.5 - mask_offset;
    float d = shapeDistance(p);
    // Pan is in destination/source pixels; positive values move the picture
    // right/down. Uniform zoom preserves the webcam aspect ratio.
    float2 srcUV = 0.5 + ((v_in.uv - 0.5) * uv_size - subject_pan) /
                          (max(subject_zoom, 0.5) * uv_size);
    float4 src = float4(0.0, 0.0, 0.0, 0.0);
    // The sampler uses Clamp for valid bilinear samples, but samples outside
    // the source must be transparent rather than smeared edge pixels.
    if (srcUV.x >= 0.0 && srcUV.x <= 1.0 &&
        srcUV.y >= 0.0 && srcUV.y <= 1.0)
        src = image.Sample(image_sampler, srcUV);
    float mask = 1.0 - smoothstep(-max(feather, 0.5), max(feather, 0.5), d);
    float baseA = src.a * mask;
    // OBS's non-direct filter texrender contains premultiplied RGB.
    // Multiplying src.rgb by src.a again would darken semi-transparent pixels.
    float3 premul = src.rgb * mask;
    float outA = baseA;

    // Both the core and halo are composited over the masked source in
    // premultiplied space; final output is straight alpha as expected by OBS.
    if (border_enabled != 0) {
        float angle = atan2(p.y, p.x);
        float mixAmount = saturate(0.5 + 0.5 * sin(angle + TAU * color_phase));
        float3 neon = lerp(color_a.rgb, color_b.rgb, mixAmount);
        float activity = 1.0;
        if (animation_id == 1) {
            activity = 0.72 + 0.28 * sin(TAU * pulse_phase);
        } else if (animation_id == 2) {
            float travel = cos(angle - TAU * flow_phase);
            activity = 0.52 + 0.48 * pow(saturate(0.5 + 0.5 * travel), 12.0);
        }

        float segmentAlpha = 1.0;
        if (segment_count > 1) {
            float phase = frac((angle / TAU + 0.5) * segment_count);
            segmentAlpha = smoothstep(0.015, 0.08, phase) *
                           (1.0 - smoothstep(0.82, 0.98, phase));
        }
        float band = 1.0 - smoothstep(max(0.0, border_width * 0.5 - 0.75),
                                      border_width * 0.5 + 0.75, abs(d));
        float coreA = saturate(band * activity * segmentAlpha);
        float haloA = 0.0;
        if (glow_enabled != 0 && glow_strength > 0.0) {
            float gap = max(0.0, abs(d) - border_width * 0.5);
            float radius2 = max(1.0, glow_radius * glow_radius);
            float side = d > 0.0 ? 1.0 : 0.24;
            haloA = saturate(glow_strength * activity * segmentAlpha * side *
                             exp2(-3.0 * gap * gap / radius2));
        }
        // The same SDF supplies concentric rims: no second geometry pass,
        // no texture upload and no radial image stretching on resized facecams.
        float rimA = 0.0;
        if (style_id == 1 || style_id == 2) {
            float spacing = border_width * 0.5 + 3.0;
            float outerRim = 1.0 - smoothstep(0.35, 1.30, abs(d - spacing));
            float innerRim = 1.0 - smoothstep(0.35, 1.30, abs(d + spacing));
            float rimGate = 1.0;
            if (style_id == 2) {
                float dash = frac((angle / TAU + 0.5) * 16.0);
                rimGate = smoothstep(0.015, 0.07, dash) *
                          (1.0 - smoothstep(0.75, 0.92, dash));
            }
            rimA = saturate((outerRim * 0.52 + innerRim * 0.32) *
                            activity * rimGate);
        } else if (style_id == 3) {
            // Editorial/minimal style: precise core with restrained bloom.
            coreA *= 0.68;
            haloA *= 0.42;
        }

        float3 rimColor = lerp(color_b.rgb, color_a.rgb, 0.35);
        premul = neon * haloA + premul * (1.0 - haloA);
        outA = haloA + outA * (1.0 - haloA);
        premul = rimColor * rimA + premul * (1.0 - rimA);
        outA = rimA + outA * (1.0 - rimA);
        premul = neon * coreA + premul * (1.0 - coreA);
        outA = coreA + outA * (1.0 - coreA);
    }
    // The final effect outputs straight alpha for OBS's SRC_ALPHA blend stage.
    float3 straight = outA > 0.00001 ? premul / outA : float3(0.0, 0.0, 0.0);
    return float4(straight, outA);
}

technique Draw
{
    pass {
        vertex_shader = mainTransform(v_in);
        pixel_shader = drawNeonMask(v_in);
    }
}
