// SPDX-License-Identifier: GPL-2.0-or-later
// One source-space signed-distance field drives mask, stroke and analytic halo.
// No duplicate geometry or full-frame blur texture is required for this MVP.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d svg_sdf;
uniform int svg_ready;
uniform float2 uv_size;
uniform float2 half_size;
uniform float2 mask_offset;
uniform float2 subject_pan;
uniform float subject_zoom;
uniform float shape_rotation;
uniform int polygon_sides;
uniform float shape_detail;
uniform float corner_radius;
uniform int shape_id;
uniform float border_width;
uniform int style_id;
uniform int ornament_mode;
uniform float art_intensity;
uniform float art_gap;
uniform float feather;
uniform float glow_radius;
uniform float glow_strength;
uniform float mid_glow_strength;
uniform float bloom_strength;
uniform float hotspot_strength;
uniform float hotspot_size;
uniform float4 color_a;
uniform float4 color_b;
uniform float color_phase;
uniform float pulse_phase;
uniform float flow_phase;
uniform int animation_id;
uniform int segment_count;
uniform int border_enabled;
uniform int glow_enabled;

sampler_state image_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};
sampler_state svg_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData mainTransform(VertData v_in)
{
    v_in.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    return v_in;
}

float roundedBoxDistance(float2 p, float2 bounds, float radius)
{
    float2 q = abs(p) - (bounds - radius);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
}

float ellipseDistance(float2 p, float2 r)
{
    // A close Euclidean-distance approximation; unlike UV scaling, this keeps
    // an ellipse's neon width visually consistent near the silhouette.
    float k0 = length(p / r);
    if (k0 < 0.0001) return -min(r.x, r.y);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 0.00001);
}

float2 rotatePoint(float2 p, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float regularPolygonDistance(float2 p, float2 bounds, int sides, float rotation)
{
    float2 q = rotatePoint(p, rotation) / max(bounds, float2(0.001, 0.001));
    float a = atan2(q.y, q.x);
    float sector = 6.28318530718 / max(float(sides), 3.0);
    float edge = cos(floor(0.5 + a / sector) * sector - a) * length(q) - 1.0;
    return edge * min(bounds.x, bounds.y);
}

// D1: explicit signed distances use the SAME value for image coverage,
// primary neon contour, secondary tracks and halo. No detached bubble tail.
float cross2(float2 a, float2 b)
{
    return a.x * b.y - a.y * b.x;
}

float edgeDistanceSquared(float2 p, float2 a, float2 b)
{
    float2 ab = b - a;
    float t = saturate(dot(p - a, ab) / max(dot(ab, ab), 0.0001));
    float2 e = p - a - ab * t;
    return dot(e, e);
}

float signedTriangle(float2 p, float2 a, float2 b, float2 c)
{
    float ds = min(edgeDistanceSquared(p,a,b),
                   min(edgeDistanceSquared(p,b,c),
                       edgeDistanceSquared(p,c,a)));
    float inside = min(cross2(b-a,p-a),
                       min(cross2(c-b,p-b),cross2(a-c,p-c)));
    return sqrt(ds) * (inside >= 0.0 ? -1.0 : 1.0);
}

// Top-right and bottom-left have diagonal cuts. Round only the FOUR
// vertices at the *ends* of those cuts; top-left and bottom-right remain
// exactly 90 degrees. Zero radius returns the original straight chamfer.
float arcDistanceSquared(float2 p, float2 start, float2 finish,
                         float2 center, float radius)
{
    float2 rs = start-center, re = finish-center, v = p-center;
    if (cross2(rs,v) >= 0.0 && cross2(v,re) >= 0.0) {
        float d = length(v)-radius;
        return d*d;
    }
    return min(dot(p-start,p-start),dot(p-finish,p-finish));
}

bool inTriangle(float2 p, float2 a, float2 b, float2 c)
{
    float x = cross2(b-a,p-a);
    float y = cross2(c-b,p-b);
    float z = cross2(a-c,p-c);
    const float eps = 0.0001;
    return (x >= -eps && y >= -eps && z >= -eps) ||
           (x <= eps && y <= eps && z <= eps);
}

bool excisedCorner(float2 p, float2 start, float2 vertex,
                   float2 finish, float2 center, float radius)
{
    float2 q = p-center;
    return inTriangle(p,start,vertex,finish) &&
           dot(q,q) > radius*radius;
}

float angledCardDistance(float2 p, float2 b, float detail, float radius)
{
    const float INV_ROOT2 = 0.70710678118;
    const float TAN_PI8 = 0.41421356237;
    float cut = max(1.0, min(b.x, b.y) * detail * 1.65);
    float2 a = float2(-b.x,-b.y);
    float2 c = float2(b.x-cut,-b.y);
    float2 d = float2(b.x,-b.y+cut);
    float2 e = float2(b.x,b.y);
    float2 f = float2(-b.x+cut,b.y);
    float2 g = float2(-b.x,b.y-cut);

    float inside = cross2(c-a,p-a);
    inside = min(inside,cross2(d-c,p-c));
    inside = min(inside,cross2(e-d,p-d));
    inside = min(inside,cross2(f-e,p-e));
    inside = min(inside,cross2(g-f,p-f));
    inside = min(inside,cross2(a-g,p-g));

    // Exact pre-D2 geometry when slider is zero. A nonzero setting cannot
    // accidentally round the two right-angle corners a/e.
    // At slider 1 both trimmed 45-degree arcs join at their common
    // center and form a complete tangent quarter-circle. The old 1.20*cut
    // cap left a long flat diagonal even at the slider's maximum.
    // Normalize the pixel-space host radius so Roundness uses its entire
    // [0,1] travel independent of source aspect ratio/cut size.
    float amount = saturate(max(radius,0.0)/max(min(b.x,b.y),0.0001));
    float r = amount*cut*(1.0+INV_ROOT2);
    if (r <= 0.0001) {
        float ds = edgeDistanceSquared(p,a,c);
        ds = min(ds,edgeDistanceSquared(p,c,d));
        ds = min(ds,edgeDistanceSquared(p,d,e));
        ds = min(ds,edgeDistanceSquared(p,e,f));
        ds = min(ds,edgeDistanceSquared(p,f,g));
        ds = min(ds,edgeDistanceSquared(p,g,a));
        return sqrt(ds) * (inside >= 0.0 ? -1.0 : 1.0);
    }
    float t = r*TAN_PI8;
    float k = t*INV_ROOT2;
    float2 cs = c-float2(t,0.0), ce = c+float2(k,k);
    float2 ds = d-float2(k,k), de = d+float2(0.0,t);
    float2 fs = f+float2(t,0.0), fe = f-float2(k,k);
    float2 gs = g+float2(k,k), ge = g-float2(0.0,t);
    float2 cc = cs+float2(0.0,r);
    float2 dc = de+float2(-r,0.0);
    float2 fc = fs+float2(0.0,-r);
    float2 gc = ge+float2(r,0.0);

    // Euclidean distance to six trimmed edges and four *actual* circular
    // fillets. Both square corners retain the original sharp vertex.
    float dist2 = edgeDistanceSquared(p,a,cs);
    dist2 = min(dist2,edgeDistanceSquared(p,ce,ds));
    dist2 = min(dist2,edgeDistanceSquared(p,de,e));
    dist2 = min(dist2,edgeDistanceSquared(p,e,fs));
    dist2 = min(dist2,edgeDistanceSquared(p,fe,gs));
    dist2 = min(dist2,edgeDistanceSquared(p,ge,a));
    dist2 = min(dist2,arcDistanceSquared(p,cs,ce,cc,r));
    dist2 = min(dist2,arcDistanceSquared(p,ds,de,dc,r));
    dist2 = min(dist2,arcDistanceSquared(p,fs,fe,fc,r));
    dist2 = min(dist2,arcDistanceSquared(p,gs,ge,gc,r));

    bool removed = excisedCorner(p,cs,c,ce,cc,r) ||
                   excisedCorner(p,ds,d,de,dc,r) ||
                   excisedCorner(p,fs,f,fe,fc,r) ||
                   excisedCorner(p,gs,g,ge,gc,r);
    return sqrt(dist2) * (inside >= 0.0 && !removed ? -1.0 : 1.0);
}

// The bubble is a SINGLE exposed perimeter. min(body, triangle) is a
// correct occupancy union, but its hidden body-bottom and tail-base remain
// too close to zero inside the union and produce a phantom horizontal neon
// line. Only external rails and arcs contribute to the contour distance.
float quarterArcDistanceSquared(float2 p, float2 center, float r, float2 signXY)
{
    float2 q = (p-center)*signXY;
    if (q.x >= 0.0 && q.y >= 0.0) {
        float d = length(q)-r;
        return d*d;
    }
    float2 xEnd = center+float2(signXY.x*r,0.0);
    float2 yEnd = center+float2(0.0,signXY.y*r);
    return min(dot(p-xEnd,p-xEnd),dot(p-yEnd,p-yEnd));
}

float chatBubbleDistance(float2 p, float2 b, float radius, float detail)
{
    float tail = max(3.0, b.y * detail * 1.8);
    float bottom = b.y - tail, top = -b.y;
    float2 left = float2(-0.78*b.x,bottom);
    float2 right = float2(-0.34*b.x,bottom);
    float2 tip = float2(-0.72*b.x,b.y-1.0);
    // Constrain body corner radius before the tail shoulder so that the
    // actual bottom rails never cross the body's corner arcs.
    float r = min(max(radius,0.0),min(b.y-0.5*tail,0.22*b.x));
    float2 lv = left-tip, rv = right-tip;
    float ll = length(lv), rl = length(rv);
    float2 ul = lv/max(ll,0.0001), ur = rv/max(rl,0.0001);
    float cosine = clamp(dot(ul,ur),-0.98,0.98);
    float sinHalf = sqrt(0.5*(1.0-cosine));
    float tanHalf = sinHalf/sqrt(max(0.01,0.5*(1.0+cosine)));
    // A compact circular leaf tip, tangent to both tail sides. No
    // additional UI control; the existing Roundness slider is authoritative.
    float desired = min(1.8,min(tail*0.12,r*0.24));
    float trim = min(desired/max(tanHalf,0.01),min(ll,rl)*0.32);
    float tipR = trim*tanHalf;
    float2 rightTangent = tip+ur*trim;
    float2 leftTangent = tip+ul*trim;
    float2 bis = ul+ur;
    float2 tipCenter = tip + bis*(tipR/max(sinHalf*length(bis),0.0001));

    float2 topLeft = float2(-b.x+r,top), topRight = float2(b.x-r,top);
    float2 rightTop = float2(b.x,top+r), rightBottom = float2(b.x,bottom-r);
    float2 bottomRight = float2(b.x-r,bottom), bottomLeft = float2(-b.x+r,bottom);
    float2 leftBottom = float2(-b.x,bottom-r), leftTop = float2(-b.x,top+r);

    float ds = edgeDistanceSquared(p,topLeft,topRight);
    ds = min(ds,edgeDistanceSquared(p,rightTop,rightBottom));
    ds = min(ds,edgeDistanceSquared(p,bottomRight,right));
    ds = min(ds,edgeDistanceSquared(p,right,rightTangent));
    ds = min(ds,edgeDistanceSquared(p,leftTangent,left));
    ds = min(ds,edgeDistanceSquared(p,left,bottomLeft));
    ds = min(ds,edgeDistanceSquared(p,leftBottom,leftTop));
    ds = min(ds,quarterArcDistanceSquared(p,float2(b.x-r,top+r),r,float2(1.0,-1.0)));
    ds = min(ds,quarterArcDistanceSquared(p,float2(b.x-r,bottom-r),r,float2(1.0,1.0)));
    ds = min(ds,quarterArcDistanceSquared(p,float2(-b.x+r,bottom-r),r,float2(-1.0,1.0)));
    ds = min(ds,quarterArcDistanceSquared(p,float2(-b.x+r,top+r),r,float2(-1.0,-1.0)));
    if(tipR > 0.0001)
        ds = min(ds,arcDistanceSquared(p,rightTangent,leftTangent,tipCenter,tipR));
    else
        ds = min(ds,edgeDistanceSquared(p,rightTangent,leftTangent));

    // Occupancy only: the primitive base is NOT an external neon edge.
    float2 bodyP = p+float2(0.0,0.5*tail);
    float body = roundedBoxDistance(bodyP,float2(b.x,b.y-0.5*tail),r);
    float wedge = signedTriangle(p,right,tip,left);
    bool inside = body <= 0.0 || wedge <= 0.0;
    bool removed = tipR > 0.0001 &&
        excisedCorner(p,rightTangent,tip,leftTangent,tipCenter,tipR);
    return sqrt(ds)*(inside && !removed ? -1.0 : 1.0);
}

// D2.3 authored masks: the actual image and neon share these contours.
// A non-convex step is intentional; no separate PNG/chat-style overlay.
bool hudRayCrosses(float2 p,float2 a,float2 b)
{
    if ((a.y > p.y) != (b.y > p.y))
        return p.x < a.x+(p.y-a.y)*(b.x-a.x)/(b.y-a.y);
    return false;
}

float hudPanelDistance(float2 p,float2 b,float detail)
{
    float cut=min(max(2.0,min(b.x,b.y)*detail*1.8),min(b.x,b.y)*0.45);
    // Art-directed bevels at both notch shoulders, not blocky stairs.
    float2 v0=float2(-b.x,-b.y);
    float2 v1=float2(b.x-cut,-b.y);
    float2 v2=float2(b.x,-b.y+cut);
    float2 v3=float2(b.x,b.y-cut*0.40);
    float2 v4=float2(b.x-cut*0.35,b.y);
    float2 v5=float2(-b.x+cut*1.80,b.y);
    float2 v6=float2(-b.x+cut*1.65,b.y-cut*0.20);
    float2 v7=float2(-b.x+cut*1.13,b.y-cut*0.20);
    float2 v8=float2(-b.x+cut*0.95,b.y-cut*0.38);
    float2 v9=float2(-b.x+cut*0.95,b.y-cut*0.70);
    float2 v10=float2(-b.x,b.y-cut*0.70);
    float ds=edgeDistanceSquared(p,v10,v0);
    bool inside=false;
    ds=min(ds,edgeDistanceSquared(p,v0,v1));
    if(hudRayCrosses(p,v0,v1)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v1,v2));
    if(hudRayCrosses(p,v1,v2)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v2,v3));
    if(hudRayCrosses(p,v2,v3)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v3,v4));
    if(hudRayCrosses(p,v3,v4)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v4,v5));
    if(hudRayCrosses(p,v4,v5)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v5,v6));
    if(hudRayCrosses(p,v5,v6)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v6,v7));
    if(hudRayCrosses(p,v6,v7)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v7,v8));
    if(hudRayCrosses(p,v7,v8)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v8,v9));
    if(hudRayCrosses(p,v8,v9)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v9,v10));
    if(hudRayCrosses(p,v9,v10)) inside=!inside;
    ds=min(ds,edgeDistanceSquared(p,v10,v0));
    if(hudRayCrosses(p,v10,v0)) inside=!inside;
    return sqrt(ds)*(inside ? -1.0 : 1.0);
}

float squircleDistance(float2 p,float2 b,float detail)
{
    // Superellipse F=|x/a|^n+|y/b|^n-1; normalized gradient controls
    // pixel-space core thickness close to the boundary on 16:9 and portrait.
    float exponent=4.0+(detail-0.08)/0.27;
    float2 a=min(abs(p)/b,float2(32.0,32.0));
    float2 f=pow(a,float2(exponent,exponent));
    float2 gradient=float2(exponent*pow(a.x,exponent-1.0)/b.x,
                            exponent*pow(a.y,exponent-1.0)/b.y);
    float d=(f.x+f.y-1.0)/max(length(gradient),1.0/min(b.x,b.y));
    // Exact near-axis superellipse intersection stabilizes long luminous
    // top/side rails; smooth blend retains the curved corner SDF.
    if(a.x<0.72 && a.y>0.72) {
        float rem=max(0.00001,1.0-f.x);
        float edge=b.y*pow(rem,1.0/exponent);
        float slope=(b.y/b.x)*pow(a.x,exponent-1.0)*
                    pow(rem,1.0/exponent-1.0);
        float axis=(abs(p.y)-edge)/length(float2(1.0,slope));
        float t=smoothstep(0.58,0.72,a.x);
        d=lerp(axis,d,t);
    } else if(a.y<0.72 && a.x>0.72) {
        float rem=max(0.00001,1.0-f.y);
        float edge=b.x*pow(rem,1.0/exponent);
        float slope=(b.x/b.y)*pow(a.y,exponent-1.0)*
                    pow(rem,1.0/exponent-1.0);
        float axis=(abs(p.x)-edge)/length(float2(1.0,slope));
        float t=smoothstep(0.58,0.72,a.y);
        d=lerp(axis,d,t);
    }
    return max(d,-min(b.x,b.y));
}

float svgPathDistance(float2 p)
{
    // Texture contains signed physical-pixel distance from a bounded
    // update/resize-only CPU raster. Rotation is applied in mask space;
    // source sampling/pan/zoom remains independent.
    float2 q=rotatePoint(p,shape_rotation);
    float2 uv=q/max(half_size*2.0,float2(0.001,0.001))+0.5;
    float2 clamped=saturate(uv);
    float d=svg_sdf.Sample(svg_sampler,clamped).r;
    return d+length(max(abs(q)-half_size,0.0));
}

float shapeDistance(float2 p)
{
    if (shape_id == 12)
        return svg_ready != 0 ? svgPathDistance(p) : 4096.0;
    if (shape_id == 8)
        return chatBubbleDistance(rotatePoint(p,shape_rotation),half_size,
                                  corner_radius,shape_detail);
    if (shape_id == 9)
        return angledCardDistance(rotatePoint(p,shape_rotation),half_size,
                                  shape_detail,corner_radius);
    if (shape_id == 10)
        return hudPanelDistance(rotatePoint(p,shape_rotation),half_size,
                                shape_detail);
    if (shape_id == 11)
        return squircleDistance(rotatePoint(p,shape_rotation),half_size,
                                shape_detail);
    if (shape_id == 1) return length(p) - min(half_size.x, half_size.y);
    if (shape_id == 2) return ellipseDistance(rotatePoint(p, shape_rotation), half_size);
    if (shape_id == 3) {
        float2 q = abs(rotatePoint(p, shape_rotation));
        // Flat-top six-sided silhouette with pixel-space unit-length normals.
        return max(q.y - half_size.y,
                   0.8660254 * (q.x - half_size.x) + 0.5 * q.y);
    }
    if (shape_id == 4) {
        float2 q = abs(rotatePoint(p, shape_rotation));
        return (q.x * half_size.y + q.y * half_size.x -
                half_size.x * half_size.y) / length(half_size);
    }
    if (shape_id == 5)
        return roundedBoxDistance(rotatePoint(p, shape_rotation), half_size, 0.0);
    if (shape_id == 6)
        return regularPolygonDistance(p, half_size, 3, shape_rotation - 1.57079632679);
    if (shape_id == 7)
        return regularPolygonDistance(p, half_size, polygon_sides, shape_rotation);
    return roundedBoxDistance(rotatePoint(p, shape_rotation), half_size,
                              min(corner_radius, min(half_size.x, half_size.y)));
}

// Rounded contour turn starts at the upper-left tangent and advances along
// actual straight lengths and quarter-circle arc lengths. This is geometry,
// not angle-from-center; resize and aspect changes preserve motion rhythm.
float roundedContourTurn(float2 q, float2 bounds, float r)
{
    const float PI = 3.14159265359;
    float2 b = max(bounds, float2(1.0, 1.0));
    r = min(max(r, 0.0), min(b.x, b.y));
    float sx = b.x - r, sy = b.y - r;
    float h = 2.0 * sx, v = 2.0 * sy;
    float arc = 0.5 * PI * r;
    float lengthAll = max(1.0, 2.0*h + 2.0*v + 4.0*arc);
    float2 a = abs(q);
    float lengthAt = 0.0;
    if (a.x > sx && a.y > sy && r > 0.0) {
        float2 c = float2(q.x >= 0.0 ? sx : -sx,
                          q.y >= 0.0 ? sy : -sy);
        float theta = atan2(q.y-c.y, q.x-c.x);
        if (q.x >= 0.0 && q.y < 0.0)
            lengthAt = h + r*(theta + PI*0.5);
        else if (q.x >= 0.0)
            lengthAt = h + arc + v + r*theta;
        else if (q.y >= 0.0)
            lengthAt = h + arc + v + arc + h + r*(theta-PI*0.5);
        else
            lengthAt = h + arc + v + arc + h + arc + v + r*(theta+PI);
    } else if (a.y > sy) {
        lengthAt = q.y < 0.0 ? q.x + sx :
                   h + arc + v + arc + sx - q.x;
    } else if (q.x >= 0.0) {
        lengthAt = h + arc + q.y + sy;
    } else {
        lengthAt = h + arc + v + arc + h + arc + sy - q.y;
    }
    return frac(lengthAt / lengthAll + 1.0);
}

float segmentDistance(float2 p, float2 a, float2 b)
{
    float2 ab = b - a;
    float t = saturate(dot(p-a, ab) / max(dot(ab, ab), 0.0001));
    return length(p - a - t*ab);
}

float4 drawNeonMask(VertData v_in) : TARGET
{
    const float TAU = 6.28318530718;
    float2 sourcePos = v_in.uv * uv_size - uv_size * 0.5;
    float2 p = sourcePos - mask_offset;
    // Never expose an unmasked facecam for a missing, invalid or stale
    // external asset. Shader-not-ready failures are transparent, not bypass.
    if(shape_id == 12 && svg_ready == 0)
        return float4(0.0,0.0,0.0,0.0);
    float d = shapeDistance(p);

    // Positive pan moves the visible subject right/down inside a fixed mask.
    // Uniform zoom preserves face proportions. Explicit bounds prevent the
    // Clamp sampler from smearing source-edge pixels into translated areas.
    float2 samplePos = (sourcePos - subject_pan) / max(subject_zoom, 0.001);
    float2 sourceUV = (samplePos + uv_size * 0.5) / uv_size;
    float insideSource = step(0.0, sourceUV.x) * step(sourceUV.x, 1.0) *
                         step(0.0, sourceUV.y) * step(sourceUV.y, 1.0);
    float4 src = insideSource > 0.5 ? image.Sample(image_sampler, sourceUV) :
                                     float4(0.0, 0.0, 0.0, 0.0);
    float mask = 1.0 - smoothstep(-max(feather, 0.5), max(feather, 0.5), d);
    float baseA = src.a * mask;
    // OBS's non-direct filter texrender contains premultiplied RGB.
    // Multiplying src.rgb by src.a again would darken semi-transparent pixels.
    float3 premul = src.rgb * mask;
    float outA = baseA;

    // Phase B: three light scales on the ONE mask SDF. Keep the sharp base
    // rim visible in Static/Pulse/Flow; only bloom breathes and only a local
    // accent travels. Input RGB above is already premultiplied by libobs.
    if (border_enabled != 0) {
        float angle = atan2(p.y, p.x);
        float mixAmount = saturate(0.5 + 0.5 * sin(angle + TAU * color_phase));
        float3 neon = lerp(color_a.rgb, color_b.rgb, mixAmount);
        float3 outerColor = lerp(neon, color_b.rgb, 0.28);
        float3 midColor = lerp(neon, float3(1.0, 1.0, 1.0), 0.15);
        float3 fineColor = lerp(neon, float3(1.0, 1.0, 1.0), 0.72);

        float segmentAlpha = 1.0;
        if (segment_count > 1) {
            float phase = frac((angle / TAU + 0.5) * segment_count);
            segmentAlpha = smoothstep(0.015, 0.08, phase) *
                           (1.0 - smoothstep(0.82, 0.98, phase));
        }

        // Flow starts from a beautiful static frame; the hotspot is additive
        // instead of dimming the remaining 360 degrees of its core.
        // Angular routing is provisional until contour-length flow is built.
        float hot = 0.0;
        if (animation_id == 2 && hotspot_strength > 0.0) {
            float travelTurn = angle / TAU;
            if (ornament_mode == 1 && (shape_id == 0 || shape_id == 5))
                travelTurn = roundedContourTurn(rotatePoint(p, shape_rotation),
                                                half_size, corner_radius);
            float turnDelta = frac(travelTurn + 1.0 - flow_phase + 0.5) - 0.5;
            float width2 = max(0.0016, hotspot_size * hotspot_size);
            hot = exp2(-2.0 * turnDelta * turnDelta / width2);
        }
        float breath = 1.0;
        if (animation_id == 1)
            breath = 0.74 + 0.26 * sin(TAU * pulse_phase);

        float halfCore = max(0.25, border_width * 0.5);
        float band = 1.0 - smoothstep(max(0.0, halfCore - 0.75),
                                      halfCore + 0.75, abs(d));
        float coreA = saturate(band * segmentAlpha * 0.95);
        float fineA = saturate((1.0 - smoothstep(0.0,
                         max(0.85, border_width * 0.24), abs(d))) *
                         segmentAlpha * 0.46);

        // Separate mid glow and broad bloom: independently adjustable light
        // envelopes, soft exterior and restrained inward image spill.
        // All terms stay bounded; no full-frame blur or GPU readback.
        float midA = 0.0;
        float outerA = 0.0;
        if (glow_enabled != 0 && glow_strength > 0.0) {
            float gap = max(0.0, abs(d) - halfCore);
            float midRadius = max(2.0, glow_radius * 0.36);
            float outerRadius = max(1.0, glow_radius);
            float side = d > 0.0 ? 1.0 : 0.13;
            float glowGate = 0.52 + 0.48 * segmentAlpha;
            midA = saturate(glow_strength * mid_glow_strength * 0.58 *
                            side * breath * glowGate *
                            exp2(-3.0 * gap * gap / (midRadius * midRadius)));
            outerA = saturate(glow_strength * bloom_strength * 0.46 *
                              side * breath * glowGate *
                              exp2(-2.0 * gap * gap / (outerRadius * outerRadius)));
            // Traveling brightness grows locally without switching off the
            // base frame or flashing the whole portrait.
            midA = saturate(midA * (1.0 + 0.65 * hot * hotspot_strength));
            outerA = saturate(outerA * (1.0 + 0.38 * hot * hotspot_strength));
        }

        // Visual grammar: narrow supporting tracks and anchored corner glints
        // reuse this contour. No decorative layer can change mask coverage.
        float rimA = 0.0;
        float glintA = 0.0;
        float artBarA = 0.0;
        float artBarGlowA = 0.0;
        if (style_id == 1 || style_id == 2) {
            float spacing = halfCore + 3.0;
            float outerRim = 1.0 - smoothstep(0.30, 1.15, abs(d - spacing));
            float innerRim = 1.0 - smoothstep(0.30, 1.15, abs(d + spacing));
            float rimGate = 1.0;
            if (style_id == 2) {
                float dash = frac((angle / TAU + 0.5) * 16.0);
                rimGate = smoothstep(0.015, 0.07, dash) *
                          (1.0 - smoothstep(0.75, 0.92, dash));
            }
            rimA = saturate((outerRim * 0.58 + innerRim * 0.30) * rimGate);
            if (shape_id == 0 || shape_id == 5) {
                float2 q = abs(rotatePoint(p, shape_rotation)) /
                           max(half_size, float2(1.0, 1.0));
                float cornerZone = smoothstep(0.72, 0.92, q.x) *
                                   smoothstep(0.72, 0.92, q.y);
                glintA = saturate(outerRim * cornerZone * 0.58);
            }
        } else if (style_id == 3) {
            coreA *= 0.80;
            fineA *= 0.62;
            midA *= 0.65;
            outerA *= 0.53;
        }

        // Signature Cyber: a deliberately broken supporting track plus
        // four paired contour-anchored micro-brackets. The ornament only adds
        // light; the original silhouette/baseA remains completely untouched.
        // Non-Cyber/custom scenes keep precisely their previous track rules.
        if (ornament_mode == 1 && (shape_id == 0 || shape_id == 5) &&
            art_intensity > 0.0) {
            float2 q = rotatePoint(p, shape_rotation);
            float turn = roundedContourTurn(q, half_size, corner_radius);
            float rhythm = frac(turn * 4.0 + 0.05);
            float gapGate = smoothstep(0.025, 0.075, rhythm) *
                            (1.0 - smoothstep(0.74, 0.82, rhythm));
            float spacing = halfCore + 3.0 + art_gap;
            float outerTrack = 1.0 - smoothstep(0.25, 1.25, abs(d - spacing));
            float innerTrack = 1.0 - smoothstep(0.30, 1.30, abs(d + spacing*0.64));
            rimA = saturate(rimA * 0.38 +
                       art_intensity * (outerTrack * 0.82 * gapGate +
                                        innerTrack * 0.27 * (0.45+0.55*gapGate)));

            // Author-controlled negative space: tiny paired horizontal/vertical
            // illuminated traces live OUTSIDE the rounded corner, never
            // over the subject. Their positions derive from the mask bounds.
            float2 aq = abs(q);
            float xBar = half_size.x - min(half_size.x*0.20, 35.0);
            float yBar = half_size.y - min(half_size.y*0.20, 30.0);
            float outerX = half_size.x + art_gap + 3.0;
            float outerY = half_size.y + art_gap + 3.0;
            float hbar = roundedBoxDistance(
                float2(aq.x - xBar, aq.y - outerY),
                float2(min(half_size.x*0.16, 25.0), 0.70), 0.45);
            float vbar = roundedBoxDistance(
                float2(aq.x - outerX, aq.y - yBar),
                float2(0.70, min(half_size.y*0.16, 23.0)), 0.45);
            float barDistance = min(hbar, vbar);
            artBarA = art_intensity * 0.90 *
                      (1.0 - smoothstep(0.20, 1.25, barDistance));
            if (glow_enabled != 0)
                artBarGlowA = art_intensity * glow_strength * 0.27 *
                    (1.0 - smoothstep(0.0, 4.0, barDistance));
            float2 normq = aq / max(half_size, float2(1.0, 1.0));
            float corner = smoothstep(0.70, 0.91, normq.x) *
                           smoothstep(0.70, 0.91, normq.y);
            glintA = saturate(glintA +
                              outerTrack * corner * art_intensity * 0.62);
        }

        // Reactor: two nonuniform luminous arcs, a sparse radial tick rail,
        // and a local orbit head. Its circle has a genuinely different static
        // silhouette grammar from the Cyber corner-trace recipe.
        if (ornament_mode == 2 && shape_id == 1 && art_intensity > 0.0) {
            float t = frac(angle / TAU + 1.0);
            float arcA = smoothstep(0.05, 0.095, t) *
                         (1.0 - smoothstep(0.33, 0.375, t));
            float arcB = smoothstep(0.54, 0.585, t) *
                         (1.0 - smoothstep(0.82, 0.865, t));
            float gap = halfCore + art_gap + 3.0;
            float outerRail = 1.0 - smoothstep(0.25, 1.25, abs(d-gap));
            float innerRail = 1.0 - smoothstep(0.25, 1.25, abs(d+gap*0.68));
            float ticks = frac(t*12.0);
            float tickGate = 1.0 - smoothstep(0.07, 0.16, ticks);
            float tickRail = 1.0 - smoothstep(0.30, 1.25, abs(d-gap-2.4));
            rimA = saturate(rimA*0.32 + art_intensity *
                   (outerRail*(arcA*0.90+arcB*0.62) +
                    innerRail*(arcA*0.28+arcB*0.42)));
            artBarA = art_intensity*0.42*tickGate*tickRail;
            float moving = 0.0;
            if (animation_id == 2) {
                float delta = frac(t - flow_phase + 1.5) - 0.5;
                moving = exp2(-3.0*delta*delta /
                               max(hotspot_size*hotspot_size,0.0016));
            }
            artBarA = saturate(artBarA + outerRail * moving *
                               art_intensity * hotspot_strength * 0.67);
            if (glow_enabled != 0)
                artBarGlowA = artBarA * glow_strength * 0.22;
        }

        // Tech HUD: rigid orthogonal brackets, sparse track cuts and strong
        // legible corner anchors. Coordinates follow independent mask X/Y,
        // width/height and shape rotation rather than fixed source pixels.
        if (ornament_mode == 3 && (shape_id == 5 || shape_id == 0) &&
            art_intensity > 0.0) {
            float2 q = abs(rotatePoint(p, shape_rotation));
            float gap = art_gap + 3.0;
            float xBar = half_size.x - min(half_size.x*0.28, 38.0);
            float yBar = half_size.y - min(half_size.y*0.28, 34.0);
            float dH = roundedBoxDistance(
                float2(q.x-xBar, q.y-half_size.y-gap),
                float2(min(half_size.x*0.24, 32.0), 0.75), 0.15);
            float dV = roundedBoxDistance(
                float2(q.x-half_size.x-gap, q.y-yBar),
                float2(0.75, min(half_size.y*0.24, 30.0)), 0.15);
            float bracketD = min(dH, dV);
            artBarA = art_intensity * 0.92 *
                       (1.0 - smoothstep(0.10, 1.30, bracketD));
            if (glow_enabled != 0)
                artBarGlowA = art_intensity * glow_strength * 0.22 *
                          (1.0 - smoothstep(0.0, 3.8, bracketD));
            float trackGap = halfCore + gap;
            float rail = 1.0 - smoothstep(0.25, 1.25, abs(d-trackGap));
            float slot = frac(roundedContourTurn(rotatePoint(p,shape_rotation),
                             half_size, shape_id == 5 ? 0.0 : corner_radius)
                             * 8.0 + 0.025);
            float gate = smoothstep(0.08, 0.13, slot) *
                         (1.0 - smoothstep(0.68, 0.74, slot));
            rimA = saturate(rimA * 0.18 +
                            rail * gate * art_intensity * 0.78);
        }

        // HUD Cut Panel: an asymmetrical rail keyed to its actual stepped
        // silhouette. The legacy rectangle brackets do not pretend to
        // represent this authored shape or create phantom inner outlines.
        if (ornament_mode == 3 && shape_id == 10 && art_intensity > 0.0) {
            float2 q = rotatePoint(p,shape_rotation);
            float cut = min(max(2.0,min(half_size.x,half_size.y)*
                                shape_detail*1.8),
                            min(half_size.x,half_size.y)*0.45);
            float railGap = halfCore+art_gap+3.0;
            float rail = 1.0-smoothstep(0.25,1.35,abs(d-railGap));
            float topZone = 1.0-smoothstep(2.0,cut*0.9+2.0,
                                           abs(q.y+half_size.y));
            float notchZone = (1.0-smoothstep(-half_size.x+cut*0.85,
                                -half_size.x+cut*1.60,q.x)) *
                              smoothstep(half_size.y-cut*1.15,
                                         half_size.y-cut*0.30,q.y);
            float selective = max(topZone,notchZone);
            rimA = saturate(rimA*0.36+art_intensity*rail*
                            (0.24+0.64*selective));
            glintA = saturate(glintA+art_intensity*rail*
                              (0.22*topZone+0.53*notchZone));

            // Asymmetric accent grammar distinct from a generic extra
            // contour: one short isolated top trace and one vertical
            // right-hand calibration bracket. Geometry derives from the
            // actual chamfer dimensions; leave the portrait center clear.
            float gap=art_gap+2.8;
            float2 topA=float2(-half_size.x+cut*0.38,-half_size.y-gap);
            float2 topB=float2(-half_size.x+cut*1.10,-half_size.y-gap);
            float2 sideA=float2(half_size.x+gap,-half_size.y+cut*0.73);
            float2 sideB=float2(half_size.x+gap,-half_size.y+cut*1.33);
            float traceD=min(segmentDistance(q,topA,topB),
                             segmentDistance(q,sideA,sideB));
            float trace=1.0-smoothstep(0.10,1.25,traceD);
            artBarA=saturate(artBarA+trace*art_intensity*0.88);
            if(glow_enabled != 0)
                artBarGlowA=saturate(artBarGlowA+
                           art_intensity*glow_strength*0.26*
                           (1.0-smoothstep(0.0,4.2,traceD)));
        }

        // Streamer: an intentional two-segment speech-tail line with a
        // restrained status-dot trio. The tail is decorative, NOT a change
        // to portrait mask coverage. It follows the lower-left contour.
        if (ornament_mode == 4 && shape_id == 0 && art_intensity > 0.0) {
            float2 q = rotatePoint(p, shape_rotation);
            float2 a = float2(-half_size.x*0.70, half_size.y+0.5);
            float2 tip = float2(-half_size.x*0.60,
                                 half_size.y+art_gap+7.0);
            float2 b = float2(-half_size.x*0.34, half_size.y+0.5);
            float tailD = min(segmentDistance(q,a,tip),
                              segmentDistance(q,tip,b));
            float tail = 1.0 - smoothstep(0.20, 1.35, tailD);
            float3 dotX = float3(-0.74,-0.64,-0.54) * half_size.x;
            float dotY = half_size.y - max(3.5,border_width*1.25);
            float dots = 0.0;
            dots = max(dots, 1.0-smoothstep(1.2,2.15,
                 length(q-float2(dotX.x,dotY))));
            dots = max(dots, 1.0-smoothstep(1.2,2.15,
                 length(q-float2(dotX.y,dotY))));
            dots = max(dots, 1.0-smoothstep(1.2,2.15,
                 length(q-float2(dotX.z,dotY))));
            artBarA = art_intensity * saturate(tail*0.93+dots*0.84);
            if (glow_enabled != 0)
                artBarGlowA = art_intensity * glow_strength * 0.22 *
                              (1.0-smoothstep(0.0,3.7,tailD));
            float trackGap = halfCore + art_gap + 2.0;
            float guide = 1.0-smoothstep(0.25,1.25,abs(d-trackGap));
            float t = roundedContourTurn(q,half_size,corner_radius);
            float gate = smoothstep(0.05,0.10,t) *
                        (1.0-smoothstep(0.88,0.94,t));
            rimA = saturate(rimA*0.36 +
                            guide*gate*art_intensity*0.54);
        }

        // Premultiplied 'over', from broadest envelope to fine bright line.
        // The final conversion to straight alpha below is required by OBS.
        float3 rimColor = lerp(color_b.rgb, color_a.rgb, 0.35);
        premul = outerColor * outerA + premul * (1.0 - outerA);
        outA = outerA + outA * (1.0 - outerA);
        premul = midColor * midA + premul * (1.0 - midA);
        outA = midA + outA * (1.0 - midA);
        float3 accentColor = lerp(color_b.rgb, float3(1.0, 1.0, 1.0), 0.32);
        premul = accentColor * artBarGlowA + premul * (1.0 - artBarGlowA);
        outA = artBarGlowA + outA * (1.0 - artBarGlowA);
        premul = rimColor * rimA + premul * (1.0 - rimA);
        outA = rimA + outA * (1.0 - rimA);
        premul = fineColor * glintA + premul * (1.0 - glintA);
        outA = glintA + outA * (1.0 - glintA);
        premul = accentColor * artBarA + premul * (1.0 - artBarA);
        outA = artBarA + outA * (1.0 - artBarA);
        premul = neon * coreA + premul * (1.0 - coreA);
        outA = coreA + outA * (1.0 - coreA);
        premul = fineColor * fineA + premul * (1.0 - fineA);
        outA = fineA + outA * (1.0 - fineA);

        float hotspotA = saturate(hot * hotspot_strength * band *
                                  segmentAlpha * 0.84);
        float3 hotspotColor = lerp(neon, float3(1.0, 1.0, 1.0), 0.90);
        premul = hotspotColor * hotspotA + premul * (1.0 - hotspotA);
        outA = hotspotA + outA * (1.0 - hotspotA);
    }
    // The final effect outputs straight alpha for OBS's SRC_ALPHA blend stage.
    float3 straight = outA > 0.00001 ? premul / outA : float3(0.0, 0.0, 0.0);
    return float4(straight, outA);
}

technique Draw
{
    pass {
        vertex_shader = mainTransform(v_in);
        pixel_shader = drawNeonMask(v_in);
    }
}
