// SPDX-License-Identifier: GPL-2.0-or-later
// One source-space signed-distance field drives mask, stroke and analytic halo.
// No duplicate geometry or full-frame blur texture is required for this MVP.
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_size;
uniform float2 half_size;
uniform float2 mask_offset;
uniform float2 subject_pan;
uniform float subject_zoom;
uniform float shape_rotation;
uniform int polygon_sides;
uniform float corner_radius;
uniform int shape_id;
uniform float border_width;
uniform int style_id;
uniform float feather;
uniform float glow_radius;
uniform float glow_strength;
uniform float mid_glow_strength;
uniform float bloom_strength;
uniform float hotspot_strength;
uniform float hotspot_size;
uniform float4 color_a;
uniform float4 color_b;
uniform float color_phase;
uniform float pulse_phase;
uniform float flow_phase;
uniform int animation_id;
uniform int segment_count;
uniform int border_enabled;
uniform int glow_enabled;

sampler_state image_sampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData mainTransform(VertData v_in)
{
    v_in.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    return v_in;
}

float roundedBoxDistance(float2 p, float2 bounds, float radius)
{
    float2 q = abs(p) - (bounds - radius);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
}

float ellipseDistance(float2 p, float2 r)
{
    // A close Euclidean-distance approximation; unlike UV scaling, this keeps
    // an ellipse's neon width visually consistent near the silhouette.
    float k0 = length(p / r);
    if (k0 < 0.0001) return -min(r.x, r.y);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 0.00001);
}

float2 rotatePoint(float2 p, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float regularPolygonDistance(float2 p, float2 bounds, int sides, float rotation)
{
    float2 q = rotatePoint(p, rotation) / max(bounds, float2(0.001, 0.001));
    float a = atan2(q.y, q.x);
    float sector = 6.28318530718 / max(float(sides), 3.0);
    float edge = cos(floor(0.5 + a / sector) * sector - a) * length(q) - 1.0;
    return edge * min(bounds.x, bounds.y);
}

float shapeDistance(float2 p)
{
    if (shape_id == 1) return length(p) - min(half_size.x, half_size.y);
    if (shape_id == 2) return ellipseDistance(rotatePoint(p, shape_rotation), half_size);
    if (shape_id == 3) {
        float2 q = abs(rotatePoint(p, shape_rotation));
        // Flat-top six-sided silhouette with pixel-space unit-length normals.
        return max(q.y - half_size.y,
                   0.8660254 * (q.x - half_size.x) + 0.5 * q.y);
    }
    if (shape_id == 4) {
        float2 q = abs(rotatePoint(p, shape_rotation));
        return (q.x * half_size.y + q.y * half_size.x -
                half_size.x * half_size.y) / length(half_size);
    }
    if (shape_id == 5)
        return roundedBoxDistance(rotatePoint(p, shape_rotation), half_size, 0.0);
    if (shape_id == 6)
        return regularPolygonDistance(p, half_size, 3, shape_rotation - 1.57079632679);
    if (shape_id == 7)
        return regularPolygonDistance(p, half_size, polygon_sides, shape_rotation);
    return roundedBoxDistance(rotatePoint(p, shape_rotation), half_size,
                              min(corner_radius, min(half_size.x, half_size.y)));
}

float4 drawNeonMask(VertData v_in) : TARGET
{
    const float TAU = 6.28318530718;
    float2 sourcePos = v_in.uv * uv_size - uv_size * 0.5;
    float2 p = sourcePos - mask_offset;
    float d = shapeDistance(p);

    // Positive pan moves the visible subject right/down inside a fixed mask.
    // Uniform zoom preserves face proportions. Explicit bounds prevent the
    // Clamp sampler from smearing source-edge pixels into translated areas.
    float2 samplePos = (sourcePos - subject_pan) / max(subject_zoom, 0.001);
    float2 sourceUV = (samplePos + uv_size * 0.5) / uv_size;
    float insideSource = step(0.0, sourceUV.x) * step(sourceUV.x, 1.0) *
                         step(0.0, sourceUV.y) * step(sourceUV.y, 1.0);
    float4 src = insideSource > 0.5 ? image.Sample(image_sampler, sourceUV) :
                                     float4(0.0, 0.0, 0.0, 0.0);
    float mask = 1.0 - smoothstep(-max(feather, 0.5), max(feather, 0.5), d);
    float baseA = src.a * mask;
    // OBS's non-direct filter texrender contains premultiplied RGB.
    // Multiplying src.rgb by src.a again would darken semi-transparent pixels.
    float3 premul = src.rgb * mask;
    float outA = baseA;

    // Phase B: three light scales on the ONE mask SDF. Keep the sharp base
    // rim visible in Static/Pulse/Flow; only bloom breathes and only a local
    // accent travels. Input RGB above is already premultiplied by libobs.
    if (border_enabled != 0) {
        float angle = atan2(p.y, p.x);
        float mixAmount = saturate(0.5 + 0.5 * sin(angle + TAU * color_phase));
        float3 neon = lerp(color_a.rgb, color_b.rgb, mixAmount);
        float3 outerColor = lerp(neon, color_b.rgb, 0.28);
        float3 midColor = lerp(neon, float3(1.0, 1.0, 1.0), 0.15);
        float3 fineColor = lerp(neon, float3(1.0, 1.0, 1.0), 0.72);

        float segmentAlpha = 1.0;
        if (segment_count > 1) {
            float phase = frac((angle / TAU + 0.5) * segment_count);
            segmentAlpha = smoothstep(0.015, 0.08, phase) *
                           (1.0 - smoothstep(0.82, 0.98, phase));
        }

        // Flow starts from a beautiful static frame; the hotspot is additive
        // instead of dimming the remaining 360 degrees of its core.
        // Angular routing is provisional until contour-length flow is built.
        float hot = 0.0;
        if (animation_id == 2 && hotspot_strength > 0.0) {
            float turnDelta = frac(angle / TAU + 1.0 - flow_phase + 0.5) - 0.5;
            float width2 = max(0.0016, hotspot_size * hotspot_size);
            hot = exp2(-2.0 * turnDelta * turnDelta / width2);
        }
        float breath = 1.0;
        if (animation_id == 1)
            breath = 0.74 + 0.26 * sin(TAU * pulse_phase);

        float halfCore = max(0.25, border_width * 0.5);
        float band = 1.0 - smoothstep(max(0.0, halfCore - 0.75),
                                      halfCore + 0.75, abs(d));
        float coreA = saturate(band * segmentAlpha * 0.95);
        float fineA = saturate((1.0 - smoothstep(0.0,
                         max(0.85, border_width * 0.24), abs(d))) *
                         segmentAlpha * 0.46);

        // Separate mid glow and broad bloom: independently adjustable light
        // envelopes, soft exterior and restrained inward image spill.
        // All terms stay bounded; no full-frame blur or GPU readback.
        float midA = 0.0;
        float outerA = 0.0;
        if (glow_enabled != 0 && glow_strength > 0.0) {
            float gap = max(0.0, abs(d) - halfCore);
            float midRadius = max(2.0, glow_radius * 0.36);
            float outerRadius = max(1.0, glow_radius);
            float side = d > 0.0 ? 1.0 : 0.13;
            float glowGate = 0.52 + 0.48 * segmentAlpha;
            midA = saturate(glow_strength * mid_glow_strength * 0.58 *
                            side * breath * glowGate *
                            exp2(-3.0 * gap * gap / (midRadius * midRadius)));
            outerA = saturate(glow_strength * bloom_strength * 0.46 *
                              side * breath * glowGate *
                              exp2(-2.0 * gap * gap / (outerRadius * outerRadius)));
            // Traveling brightness grows locally without switching off the
            // base frame or flashing the whole portrait.
            midA = saturate(midA * (1.0 + 0.65 * hot * hotspot_strength));
            outerA = saturate(outerA * (1.0 + 0.38 * hot * hotspot_strength));
        }

        // Visual grammar: narrow supporting tracks and anchored corner glints
        // reuse this contour. No decorative layer can change mask coverage.
        float rimA = 0.0;
        float glintA = 0.0;
        if (style_id == 1 || style_id == 2) {
            float spacing = halfCore + 3.0;
            float outerRim = 1.0 - smoothstep(0.30, 1.15, abs(d - spacing));
            float innerRim = 1.0 - smoothstep(0.30, 1.15, abs(d + spacing));
            float rimGate = 1.0;
            if (style_id == 2) {
                float dash = frac((angle / TAU + 0.5) * 16.0);
                rimGate = smoothstep(0.015, 0.07, dash) *
                          (1.0 - smoothstep(0.75, 0.92, dash));
            }
            rimA = saturate((outerRim * 0.58 + innerRim * 0.30) * rimGate);
            if (shape_id == 0 || shape_id == 5) {
                float2 q = abs(rotatePoint(p, shape_rotation)) /
                           max(half_size, float2(1.0, 1.0));
                float cornerZone = smoothstep(0.72, 0.92, q.x) *
                                   smoothstep(0.72, 0.92, q.y);
                glintA = saturate(outerRim * cornerZone * 0.58);
            }
        } else if (style_id == 3) {
            coreA *= 0.80;
            fineA *= 0.62;
            midA *= 0.65;
            outerA *= 0.53;
        }

        // Premultiplied 'over', from broadest envelope to fine bright line.
        // The final conversion to straight alpha below is required by OBS.
        float3 rimColor = lerp(color_b.rgb, color_a.rgb, 0.35);
        premul = outerColor * outerA + premul * (1.0 - outerA);
        outA = outerA + outA * (1.0 - outerA);
        premul = midColor * midA + premul * (1.0 - midA);
        outA = midA + outA * (1.0 - midA);
        premul = rimColor * rimA + premul * (1.0 - rimA);
        outA = rimA + outA * (1.0 - rimA);
        premul = fineColor * glintA + premul * (1.0 - glintA);
        outA = glintA + outA * (1.0 - glintA);
        premul = neon * coreA + premul * (1.0 - coreA);
        outA = coreA + outA * (1.0 - coreA);
        premul = fineColor * fineA + premul * (1.0 - fineA);
        outA = fineA + outA * (1.0 - fineA);

        float hotspotA = saturate(hot * hotspot_strength * band *
                                  segmentAlpha * 0.84);
        float3 hotspotColor = lerp(neon, float3(1.0, 1.0, 1.0), 0.90);
        premul = hotspotColor * hotspotA + premul * (1.0 - hotspotA);
        outA = hotspotA + outA * (1.0 - hotspotA);
    }
    // The final effect outputs straight alpha for OBS's SRC_ALPHA blend stage.
    float3 straight = outA > 0.00001 ? premul / outA : float3(0.0, 0.0, 0.0);
    return float4(straight, outA);
}

technique Draw
{
    pass {
        vertex_shader = mainTransform(v_in);
        pixel_shader = drawNeonMask(v_in);
    }
}
